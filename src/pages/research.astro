---
import Base from '../layouts/Base.astro';
import { site, research, researchExperience, publications } from '../data/site';
import { bold, mdLinks } from '../utils/text';

const pubs = [...publications].sort((a, b) => b.year - a.year);
---

<Base title="Research" description={`Research interests and publications of ${site.name}.`}>
  <div class="container">
    <header class="page-head">
      <p class="prompt"><b>{site.handle}@{site.host}</b>:~$ cat research/README.md</p>
      <h1>Research</h1>
    </header>

    <div class="layout">
      <section class="card focus">
        <p class="label">research interests</p>
        {research.focus.text.map((t) => <p set:html={mdLinks(t)} />)}
      </section>

      <section class="card interests">
        <p class="label">broader interests</p>
        <ul>
          {research.interests.map((i) => <li>{i}</li>)}
        </ul>
      </section>
    </div>

    <section class="block" aria-labelledby="exp-h">
      <h2 id="exp-h">Research experience</h2>
      <ol class="exp">
        {
          researchExperience.map((r) => (
            <li class="card">
              <p class="meta mono">
                <span class="period">{r.period}</span>
                <span>{r.org}</span>
                {r.supervisor && (
                  <span>
                    Supervisor:{' '}
                    {r.supervisor.url ? <a href={r.supervisor.url}>{r.supervisor.name}</a> : r.supervisor.name}
                  </span>
                )}
              </p>
              <h3>{r.title}</h3>
              {r.details && (
                <ul class="details">
                  {r.details.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
              )}
              {r.links && (
                <p class="links mono">
                  {r.links.map((l) => (
                    <a class="btn" href={l.url}>
                      {l.label} ↗
                    </a>
                  ))}
                </p>
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section class="block pubs" aria-labelledby="pubs-h">
      <h2 id="pubs-h">Publications</h2>
      {
        pubs.length === 0 ? (
          <p class="card empty mono">
            <span>$</span> ls publications/ <br />
            <span class="muted">(empty for now — work in progress)</span>
          </p>
        ) : (
          <ol>
            {pubs.map((p) => {
              // The whole card links to the first link (e.g. the DOI), like the project cards.
              const primary = p.links?.[0];
              const Tag = primary ? 'a' : 'div';
              return (
                <li>
                  <Tag class="card pub" href={primary?.url}>
                    <p class="year mono">{p.year}</p>
                    <div>
                      <h3 lang={p.note?.startsWith('In German') ? 'de' : undefined}>{p.title}</h3>
                      {p.note && <p class="note">{p.note}</p>}
                      <p class="authors" set:html={bold(p.authors)} />
                      <p class="venue">{p.venue}</p>
                    </div>
                    {primary && (
                      <span class="go mono" aria-hidden="true">
                        {primary.label} ↗
                      </span>
                    )}
                  </Tag>
                </li>
              );
            })}
          </ol>
        )
      }
    </section>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    gap: 14px;
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 3fr 2fr;
    }
  }
  .focus p:not(.label) {
    color: var(--muted);
    margin: 0 0 12px;
  }
  .focus p:last-of-type {
    margin-bottom: 0;
  }
  .focus :global(a) {
    color: var(--text);
  }
  .focus :global(a:hover) {
    color: var(--accent);
  }
  .interests ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .interests li {
    padding: 10px 0 10px 22px;
    border-bottom: 1px dashed var(--border);
    position: relative;
  }
  .interests li:last-child {
    border-bottom: 0;
  }
  .interests li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .block {
    margin-top: 56px;
  }
  .exp {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
  }
  .exp > li {
    padding: 26px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 0 0 10px;
    font-size: 0.78rem;
    color: var(--muted);
  }
  .meta a {
    color: var(--text);
  }
  .meta a:hover {
    color: var(--accent);
  }
  .period {
    color: var(--accent);
    font-weight: 600;
  }
  .exp h3 {
    font-size: 1.2rem;
    line-height: 1.3;
    margin-bottom: 12px;
  }
  .details {
    list-style: none;
    margin: 0;
    padding: 0;
    color: var(--muted);
  }
  .details li {
    position: relative;
    padding: 0 0 8px 20px;
  }
  .details li:last-child {
    padding-bottom: 0;
  }
  .details li::before {
    content: '▸';
    position: absolute;
    left: 0;
    color: var(--accent);
  }
  .pubs ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 12px;
  }
  .pub {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    gap: 12px;
  }
  .go {
    font-size: 0.78rem;
    color: var(--muted);
    white-space: nowrap;
    transition:
      color 0.2s,
      transform 0.2s;
  }
  a.pub:hover .go {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  @media (max-width: 560px) {
    .pub {
      grid-template-columns: 1fr auto;
    }
    .pub > div {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
  .year {
    color: var(--accent);
    margin: 2px 0 0;
    font-size: 0.85rem;
  }
  .pubs h3 {
    margin-bottom: 6px;
  }
  .authors,
  .venue {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .authors :global(strong) {
    color: var(--text);
  }
  .venue {
    font-style: italic;
  }
  .note {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .links {
    display: flex;
    gap: 8px;
    margin: 12px 0 0;
  }
  .links .btn {
    padding: 4px 10px;
    font-size: 0.75rem;
  }
  .empty {
    font-size: 0.88rem;
  }
  .empty span:first-child {
    color: var(--accent);
  }
  .muted {
    color: var(--muted);
  }
</style>
