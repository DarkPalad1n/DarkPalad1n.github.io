---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, projects } from '../data/site';
---

<Base title="Projects" description={`Selected projects by ${site.name}.`}>
  <div class="container">
    <header class="page-head">
      <p class="prompt"><b>{site.handle}@{site.host}</b>:~$ ls -la ./projects</p>
      <h1>Projects</h1>
      <p>Things I have built, studied or broken on purpose.</p>
    </header>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} />)}
    </div>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
  }
</style>
