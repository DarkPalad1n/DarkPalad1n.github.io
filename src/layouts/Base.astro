---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { href: '/', label: '~' },
  { href: '/research/', label: 'research' },
  { href: '/projects/', label: 'projects' },
  site.blog && { href: '/blog/', label: 'blog' },
  { href: '/cv/', label: 'cv' },
].filter(Boolean) as { href: string; label: string }[];
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {site.blog && <link rel="alternate" type="application/rss+xml" title={`${site.name} · Blog`} href="/rss.xml" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" preload />
    <ClientRouter />
    <script is:inline>
      // Apply the saved theme before paint, and again after every in-page navigation
      // (the router swaps in the new <html> attributes, which would drop data-theme).
      (() => {
        const apply = (doc) => {
          try {
            const t = localStorage.getItem('theme');
            if (t === 'light' || t === 'dark') doc.documentElement.dataset.theme = t;
          } catch {}
        };
        apply(document);
        if (window.__themeInit) return;
        window.__themeInit = true;
        // Set the theme on the incoming page *before* it is swapped in, so it never flips.
        document.addEventListener('astro:before-swap', (e) => apply(e.newDocument));
        document.addEventListener('click', (e) => {
          if (!e.target.closest?.('.theme-toggle')) return;
          const root = document.documentElement;
          const current =
            root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          const next = current === 'dark' ? 'light' : 'dark';
          root.classList.add('theme-anim');
          root.dataset.theme = next;
          setTimeout(() => root.classList.remove('theme-anim'), 300);
          try {
            localStorage.setItem('theme', next);
          } catch {}
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <a href="/" class="brand mono" aria-label="Home">
          <span class="u">{site.handle}</span><span class="at">@</span><span class="h">{site.host}</span><span class="c">:</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} class:list={['mono', { active: isActive(n.href) }]} aria-current={isActive(n.href) ? 'page' : undefined}>
                    {n.href === '/' ? '~' : `/${n.label}`}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle theme">
          <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"></circle><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></g></svg>
          <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="currentColor"></path></svg>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container foot mono">
        <span>© {year} {site.name}</span>
        <span class="links">
          {site.links.github && <a href={site.links.github}>github</a>}
          {site.links.linkedin && <a href={site.links.linkedin}>linkedin</a>}
          {site.links.scholar && <a href={site.links.scholar}>scholar</a>}
          {site.blog && <a href="/rss.xml">rss</a>}
        </span>
        <span class="exit">exit 0</span>
      </div>
    </footer>

  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 8px;
    background: var(--accent);
    color: var(--bg);
    padding: 6px 12px;
    border-radius: 8px;
    z-index: 10;
  }
  .skip:focus {
    left: 8px;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    backdrop-filter: blur(12px);
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--border);
    view-transition-name: header;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 60px;
  }
  .brand {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .brand .u {
    color: var(--accent);
  }
  .brand .at,
  .brand .c {
    color: var(--muted);
  }
  nav {
    margin-left: auto;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav ul {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 0.85rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  nav a.active {
    color: var(--accent);
    background: var(--accent-soft);
  }
  .theme-toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .theme-toggle .sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .theme-toggle .sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .theme-toggle .moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle .sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle .moon {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .brand {
      display: none;
    }
    nav {
      margin-left: -8px;
      margin-right: auto;
    }
    nav a {
      padding: 6px 6px;
      font-size: 0.8rem;
    }
  }

  main {
    view-transition-name: page;
    min-height: calc(100vh - 140px);
    padding-bottom: 72px;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    justify-content: space-between;
    padding-top: 22px;
    padding-bottom: 22px;
  }
  .foot .links {
    display: flex;
    gap: 14px;
  }
  .foot a {
    text-decoration: none;
  }
  .exit {
    color: var(--accent);
  }
</style>
